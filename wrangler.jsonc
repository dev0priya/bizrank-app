{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bizrank-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bizrank-app"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bizrank-db",
      "database_id": "e5284719-f275-4c74-b6ec-debb7ffdd6d3"
    }
  ]
}