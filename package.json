{
  "name": "business-collection",
  "version": "1.0.0",
  "description": "Business Collection module (Production Ready)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "test:geo": "ts-node services/test_geography_v2.ts",
    "test:opp": "ts-node services/test_opportunity_scorer.ts",
    "test:links": "ts-node services/test_business_links.ts",
    "test:e2e": "ts-node services/verify_e2e.ts",
    "test:real": "ts-node services/test_real_discovery.ts",
    "test:all": "ts-node services/test_opportunity_scorer.ts && ts-node services/test_geography_v2.ts && ts-node services/verify_e2e.ts",
    "type-check": "tsc --noEmit",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@vercel/node": "^5.8.26",
    "apify-client": "^2.9.2",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "framer-motion": "^12.42.2",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^20.11.20",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
