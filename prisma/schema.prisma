generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MASTER TABLES
// ==========================================

model Country {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  code   String?
  states State[]

  businesses Business[]
}

// State type: STATE or UNION_TERRITORY
model State {
  id        Int     @id @default(autoincrement())
  name      String
  code      String? // ISO 3166-2 code e.g. "IN-DL" for Delhi
  type      String  @default("STATE") // STATE | UNION_TERRITORY
  countryId Int
  country   Country @relation(fields: [countryId], references: [id])
  districts District[]
  cities    City[]

  businesses      Business[]
  searchLocations SearchLocation[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime   @default(now())

  @@unique([countryId, name])
}

model District {
  id           Int           @id @default(autoincrement())
  name         String
  stateId      Int
  state        State         @relation(fields: [stateId], references: [id])
  subdistricts SubDistrict[]
  businesses   Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model SubDistrict {
  id         Int      @id @default(autoincrement())
  name       String
  districtId Int
  district   District @relation(fields: [districtId], references: [id])
  cities     City[]
  businesses Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model City {
  id            Int          @id @default(autoincrement())
  name          String
  type          String?      // CITY, TOWN, VILLAGE, CENSUS_TOWN, etc.
  stateId       Int?
  state         State?       @relation(fields: [stateId], references: [id])
  subdistrictId Int?
  subdistrict   SubDistrict? @relation(fields: [subdistrictId], references: [id])
  latitude      Float?
  longitude     Float?
  areas         Area[]
  businesses    Business[]
  searchLocations SearchLocation[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model Area {
  id      Int     @id @default(autoincrement())
  name    String
  cityId  Int
  city    City    @relation(fields: [cityId], references: [id])
  latitude  Float?
  longitude Float?
  businesses Business[]
  searchLocations SearchLocation[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

// ==========================================
// LOCATION SEARCH (for autocomplete)
// ==========================================

// Denormalized search index for fast location autocomplete
model SearchLocation {
  id          Int     @id @default(autoincrement())
  name        String  // Display name e.g. "Rohini"
  displayName String  // Full display e.g. "Rohini, Delhi"
  type        String  // CITY | AREA | LOCALITY | TOWN | SUBURB
  stateId     Int
  state       State   @relation(fields: [stateId], references: [id])
  cityId      Int?
  city        City?   @relation(fields: [cityId], references: [id])
  areaId      Int?
  area        Area?   @relation(fields: [areaId], references: [id])
  latitude    Float?
  longitude   Float?
  source      String  @default("SEED") // SEED | CENSUS | OSM | LGD
  sourceId    String?

  @@index([stateId])
  @@index([name])
  @@map("search_locations")
}

// ==========================================
// BUSINESS CATEGORIES
// ==========================================

model BusinessCategory {
  id                       Int     @id @default(autoincrement())
  name                     String  @unique
  displayName              String?
  // 0.0 = no opportunity, 1.0 = maximum opportunity
  websiteOpportunityWeight Float   @default(0.5)
  // false = ATM/petrol pump/govt office etc — never a website lead
  opportunityEligible      Boolean @default(true)
  // Provider keywords that map to this category
  providerKeywords         String? // JSON array stored as string

  businesses Business[]
}

// ==========================================
// BACKGROUND JOBS
// ==========================================

model CollectionJob {
  id          Int        @id @default(autoincrement())
  apifyRunId  String?    
  provider    String     @default("apify")
  status      String     // 'Pending', 'Running', 'Completed', 'Failed'
  query       String     // Summary of parameters e.g., "Plumbers, Austin, TX"
  progress    Int        @default(0)
  total       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  countryId   Int?
  stateId     Int?
  districtId  Int?
  cityId      Int?
  areaId      Int?
  categoryId  Int?

  // Extended geographic context
  locationName  String?  // User-entered location name e.g. "Rohini"
  locationLat   Float?   // Resolved latitude
  locationLng   Float?   // Resolved longitude
  radiusKm      Float?   @default(5.0)  // Search radius in km
  
  businesses  Business[] 

  @@map("collection_jobs")
}

// ==========================================
// BUSINESS LEADS (CORE)
// ==========================================

// Website status enum values (stored as String for SQLite/PG compatibility)
// UNKNOWN | NO_WEBSITE | WEBSITE_FOUND | WEBSITE_VERIFIED | LOW_QUALITY_WEBSITE

// Opportunity level values
// HIGH | MEDIUM | LOW | NOT_TARGET

model Business {
  id                Int      @id @default(autoincrement())
  // The discovery provider that supplied the canonical place identity.
  provider          String   @default("apify")
  place_id          String?  @unique
  business_name     String
  
  // Relations to Master Tables
  category_id       Int?
  category          BusinessCategory? @relation(fields: [category_id], references: [id])
  
  area_id           Int?
  area              Area? @relation(fields: [area_id], references: [id])
  
  city_id           Int?
  city              City? @relation(fields: [city_id], references: [id])

  subdistrict_id    Int?
  subdistrict       SubDistrict? @relation(fields: [subdistrict_id], references: [id])

  district_id       Int?
  district          District? @relation(fields: [district_id], references: [id])
  
  state_id          Int?
  state             State? @relation(fields: [state_id], references: [id])
  
  country_id        Int?
  country           Country? @relation(fields: [country_id], references: [id])
  
  full_address      String?
  phone_number      String?
  website           String?
  website_exists    Boolean  @default(false)
  // Detailed website status
  website_status    String   @default("UNKNOWN") // UNKNOWN | NO_WEBSITE | WEBSITE_FOUND | WEBSITE_VERIFIED | LOW_QUALITY_WEBSITE
  email             String?
  google_maps_url   String?
  
  rating            Float?
  review_count      Int?
  latitude          Float?
  longitude         Float?

  // Exact Google Maps / Provider Data Fields
  google_category   String?
  owner_name        String?
  business_status   String?

  // Social presence
  instagram_url     String?
  facebook_url      String?

  // Separation of Scores
  ai_score          Int?     // Based on website quality audit
  opportunity_score Int?     // Deterministic opportunity score (0-100)

  // Opportunity Classification
  opportunity_level    String?  @default("UNKNOWN") // HIGH | MEDIUM | LOW | NOT_TARGET | UNKNOWN
  opportunity_eligible Boolean  @default(true)       // false = ATM/govt office etc.

  // Expanded Website Audit
  audit_mobile_responsive Boolean?
  audit_https             Boolean?
  audit_speed_score       Int?
  audit_seo_score         Int?
  audit_ux_score          Int?
  audit_contact_visible   Boolean?
  audit_booking_engine    Boolean?
  
  // Workflow Status
  discovery_status        String   @default("Discovered") // Discovered | Audited | Qualified
  crm_status              String?  // Only populated if pushed to CRM pipeline
  priority                String?  // Priority A, B, C
  revenue                 Float?
  assigned_user           String?
  
  collection_date   DateTime @default(now())
  
  job_id            Int?
  job               CollectionJob? @relation(fields: [job_id], references: [id])

  // Relations
  timeline_events         TimelineEvent[]
  notes                   Note[]
  tasks                   Task[]
  crm_lead                CRMLead?

  @@index([state_id])
  @@index([provider, place_id])
  @@index([opportunity_level])
  @@index([website_status])
  @@index([opportunity_score])
  @@map("businesses")
}

// ==========================================
// CRM MODULES
// ==========================================

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  action      String
  notes       String?
  user        String?
  
  business_id Int
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("timeline_events")
}

model Note {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  author      String
  content     String
  
  business_id Int
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Task {
  id            Int      @id @default(autoincrement())
  dueDate       DateTime
  priority      String   // High, Medium, Low
  status        String   // Pending, Completed
  assignedUser  String
  content       String
  
  business_id   Int
  business      Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model CRMLead {
  id                Int             @id @default(autoincrement())
  businessId        Int             @unique
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  pipelineStageId   Int
  pipelineStage     PipelineStage   @relation(fields: [pipelineStageId], references: [id])
  
  priority          String?         // 'A', 'B', 'C'
  leadScore         Int             @default(0)
  estimatedValue    Float           @default(0.0)
  assignedTo        String?         // Assigned agent identifier (Username/Email)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // CRM Child Relations
  contacts          Contact[]
  activities        Activity[]
  notes             CRMNote[]
  followUps         FollowUp[]
  deals             Deal[]
  tags              LeadTag[]

  @@index([pipelineStageId])
  @@index([assignedTo])
  @@index([priority])
  @@map("crm_leads")
}

model Contact {
  id                     Int       @id @default(autoincrement())
  crmLeadId              Int
  crmLead                CRMLead   @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  
  name                   String
  role                   String?   // 'Owner', 'Manager', 'IT Administrator', etc.
  phone                  String?
  email                  String?
  whatsapp               String?
  preferredContactMethod String?   // 'EMAIL', 'PHONE', 'WHATSAPP'
  isPrimary              Boolean   @default(false)
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  activities             Activity[]
  followUps              FollowUp[]

  @@index([crmLeadId])
  @@map("crm_contacts")
}

model Pipeline {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  stages      PipelineStage[]
  createdAt   DateTime        @default(now())
  
  @@map("crm_pipelines")
}

model PipelineStage {
  id          Int        @id @default(autoincrement())
  name        String     @unique // 'New', 'Contacted', 'Meeting Scheduled', 'Proposal Sent', 'Closed Won', 'Closed Lost'
  order       Int        // Column display order (1, 2, 3...)
  pipelineId  Int
  pipeline    Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads       CRMLead[]
  
  createdAt   DateTime   @default(now())

  @@index([pipelineId])
  @@index([order])
  @@map("crm_pipeline_stages")
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  DEMO
  PROPOSAL
  OTHER
}

model Activity {
  id          Int          @id @default(autoincrement())
  crmLeadId   Int
  crmLead     CRMLead      @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  
  contactId   Int?         @map("contact_id")
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  type        ActivityType
  outcome     String?      // 'Connected', 'No Answer', 'Busy', etc.
  summary     String       // Brief title
  details     String?      // Full description block
  performedBy String       // Agent name/identifier
  occurredAt  DateTime     @default(now())
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([crmLeadId])
  @@index([contactId])
  @@index([type])
  @@index([occurredAt])
  @@map("crm_activities")
}

model CRMNote {
  id          Int      @id @default(autoincrement())
  crmLeadId   Int
  crmLead     CRMLead  @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  
  author      String
  content     String   // Long-term guidelines (e.g. "Do not call before 2 PM")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([crmLeadId])
  @@map("crm_notes")
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model FollowUp {
  id          Int            @id @default(autoincrement())
  crmLeadId   Int
  crmLead     CRMLead        @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  
  contactId   Int?           @map("contact_id")
  contact     Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  assignedTo  String?
  dueAt       DateTime
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?
  outcome     String?
  reminderAt  DateTime?      @map("reminder_at")
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([crmLeadId])
  @@index([contactId])
  @@index([status])
  @@index([dueAt])
  @@map("crm_follow_ups")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

model Deal {
  id                Int        @id @default(autoincrement())
  crmLeadId         Int
  crmLead           CRMLead    @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  
  name              String?
  description       String?
  value             Float      @default(0.0)
  currency          String     @default("USD")
  expectedCloseDate DateTime?
  status            DealStatus @default(OPEN)
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([crmLeadId])
  @@index([status])
  @@map("crm_deals")
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique // 'HOT', 'WEBSITE_UPGRADE', 'URGENT'
  leads     LeadTag[]
  createdAt DateTime  @default(now())
  
  @@map("crm_tags")
}

model LeadTag {
  crmLeadId Int
  crmLead   CRMLead @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([crmLeadId, tagId])
  @@map("crm_lead_tags")
}

model CRMAuditLog {
  id            Int      @id @default(autoincrement())
  performedBy   String   // User username or agent email
  action        String   // 'LEAD_CREATED', 'STAGE_CHANGED', 'DEAL_WON', etc.
  entityType    String   // 'CRMLead', 'Deal', 'Activity'
  entityId      Int
  previousValue String?  // Stringified state or value
  newValue      String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("crm_audit_logs")
}

model DiscoverySearchHistory {
  id           Int      @id @default(autoincrement())
  locationName String
  categoryName String?
  filters      String?  // JSON string
  provider     String   @default("mock")
  resultCount  Int      @default(0)
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())

  @@map("discovery_search_history")
}

model DiscoverySavedSearch {
  id                Int      @id @default(autoincrement())
  name              String
  countryName       String   @default("India")
  stateId           Int?
  stateName         String?
  locationName      String
  categoryId        Int?
  categoryName      String?
  minRating         Float?
  maxRating         Float?
  minReviews        Int?
  maxReviews        Int?
  websiteFilter     String?
  phoneFilter       String?
  opportunityFilter String?
  createdAt         DateTime @default(now())

  @@map("discovery_saved_searches")
}
