generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MASTER TABLES
// ==========================================

model Country {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  code   String?
  states State[]

  businesses Business[]
}

model State {
  id        Int     @id @default(autoincrement())
  name      String
  countryId Int
  country   Country @relation(fields: [countryId], references: [id])
  districts District[]
  cities    City[]

  businesses Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime   @default(now())
}

model District {
  id           Int           @id @default(autoincrement())
  name         String
  stateId      Int
  state        State         @relation(fields: [stateId], references: [id])
  subdistricts SubDistrict[]
  businesses   Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model SubDistrict {
  id         Int      @id @default(autoincrement())
  name       String
  districtId Int
  district   District @relation(fields: [districtId], references: [id])
  cities     City[]
  businesses Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model City {
  id            Int          @id @default(autoincrement())
  name          String
  type          String?      // CITY, TOWN, VILLAGE, CENSUS_TOWN, etc.
  stateId       Int?
  state         State?       @relation(fields: [stateId], references: [id])
  subdistrictId Int?
  subdistrict   SubDistrict? @relation(fields: [subdistrictId], references: [id])
  areas         Area[]
  businesses    Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model Area {
  id      Int     @id @default(autoincrement())
  name    String
  cityId  Int
  city    City    @relation(fields: [cityId], references: [id])
  businesses Business[]

  source        String?
  sourceCode    String?
  sourceDataset String?
  sourceVersion String?
  sourceUrl     String?
  importedAt    DateTime     @default(now())
}

model BusinessCategory {
  id    Int     @id @default(autoincrement())
  name  String  @unique

  businesses Business[]
}

// ==========================================
// BACKGROUND JOBS
// ==========================================

model CollectionJob {
  id          Int        @id @default(autoincrement())
  apifyRunId  String?    
  provider    String     @default("apify")
  status      String     // 'Pending', 'Running', 'Completed', 'Failed'
  query       String     // Summary of parameters e.g., "Plumbers, Austin, TX"
  progress    Int        @default(0)
  total       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  businesses  Business[] 

  @@map("collection_jobs")
}

// ==========================================
// BUSINESS LEADS (CORE)
// ==========================================

model Business {
  id                Int      @id @default(autoincrement())
  place_id          String?  @unique
  business_name     String
  
  // Relations to Master Tables
  category_id       Int?
  category          BusinessCategory? @relation(fields: [category_id], references: [id])
  
  area_id           Int?
  area              Area? @relation(fields: [area_id], references: [id])
  
  city_id           Int?
  city              City? @relation(fields: [city_id], references: [id])

  subdistrict_id    Int?
  subdistrict       SubDistrict? @relation(fields: [subdistrict_id], references: [id])

  district_id       Int?
  district          District? @relation(fields: [district_id], references: [id])
  
  state_id          Int?
  state             State? @relation(fields: [state_id], references: [id])
  
  country_id        Int?
  country           Country? @relation(fields: [country_id], references: [id])
  
  full_address      String?
  phone_number      String?
  website           String?
  website_exists    Boolean  @default(false)
  email             String?
  google_maps_url   String?  // Keep as optional fallback
  
  rating            Float?
  review_count      Int?
  latitude          Float?
  longitude         Float?

  // Exact Google Maps Data Fields
  google_category   String?
  owner_name        String?
  business_status   String?

  // Separation of Scores
  ai_score          Int?     // Based on website quality
  opportunity_score Int?     // Based on business size, revenue potential

  // Expanded Website Audit
  audit_mobile_responsive Boolean?
  audit_https             Boolean?
  audit_speed_score       Int?
  audit_seo_score         Int?
  audit_ux_score          Int?
  audit_contact_visible   Boolean?
  audit_booking_engine    Boolean?
  
  // Workflow Status
  discovery_status        String   @default("Discovered") // e.g., Discovered, Audited, Qualified
  crm_status              String?  // Only populated if pushed to CRM pipeline
  priority                String?  // Priority A, B, C
  revenue                 Float?
  assigned_user           String?
  
  collection_date   DateTime @default(now())
  
  job_id            Int?
  job               CollectionJob? @relation(fields: [job_id], references: [id])

  // Relations
  timeline_events         TimelineEvent[]
  notes                   Note[]
  tasks                   Task[]

  @@map("businesses")
}

// ==========================================
// CRM MODULES
// ==========================================

model TimelineEvent {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  action      String
  notes       String?
  user        String?
  
  business_id Int
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("timeline_events")
}

model Note {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  author      String
  content     String
  
  business_id Int
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Task {
  id            Int      @id @default(autoincrement())
  dueDate       DateTime
  priority      String   // High, Medium, Low
  status        String   // Pending, Completed
  assignedUser  String
  content       String
  
  business_id   Int
  business      Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("tasks")
}
