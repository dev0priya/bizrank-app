# Required Environment Variables for Production

# APIFY Configuration
# Retrieve this from your Apify account settings.
# Used to trigger the Google Maps Scraper actor.
APIFY_API_TOKEN="your_apify_api_token_here"

# Database Configuration (Prisma / PostgreSQL)
# Must be a valid PostgreSQL connection string.
# Example: postgres://username:password@hostname:5432/databasename?schema=public
DATABASE_URL="your_postgresql_database_url_here"
